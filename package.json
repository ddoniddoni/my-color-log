{
  "name": "mycolorlog",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo-google-fonts/bricolage-grotesque": "^0.4.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@shopify/react-native-skia": "2.6.2",
    "@supabase/supabase-js": "^2.110.6",
    "@tanstack/react-query": "^5.101.2",
    "expo": "~57.0.30",
    "expo-camera": "~57.0.6",
    "expo-constants": "~57.0.5",
    "expo-crypto": "~57.0.4",
    "expo-dev-client": "~57.0.20",
    "expo-file-system": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.13",
    "expo-media-library": "~57.0.5",
    "expo-notifications": "~57.0.23",
    "expo-router": "~57.0.28",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.23",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-view-shot": "5.1.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.86.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "jest-expo": "~57.0.6",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "start:dev": "APP_VARIANT=development expo start --dev-client",
    "build:preview:android": "npx --yes eas-cli@25.2.0 build --profile preview --platform android",
    "build:preview:ios": "npx --yes eas-cli@25.2.0 build --profile preview --platform ios",
    "build:preview:simulator": "npx --yes eas-cli@25.2.0 build --profile preview-simulator --platform ios",
    "build:production": "npx --yes eas-cli@25.2.0 build --profile production --platform all",
    "eas-build-post-install": "node scripts/validate-build-env.cjs",
    "test:build": "node --test scripts/__tests__/*.test.cjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:db:account-deletion": "npx --yes supabase@2.121.0 db query --local --yes --file supabase/tests/account_deletion_contract.sql",
    "test:db:diary-management": "npx --yes supabase@2.121.0 db query --local --yes --file supabase/tests/diary_management_contract.sql",
    "test:db:security": "npx --yes supabase@2.121.0 db query --local --yes --file supabase/tests/rls_security_contract.sql",
    "test:db:timezones": "npx --yes supabase@2.121.0 db query --local --yes --file supabase/tests/global_timezones_contract.sql",
    "test:db:room-visibility": "npx --yes supabase@2.121.0 db query --local --yes --file supabase/tests/room_visibility_contract.sql",
    "test:watch": "jest --watch",
    "check": "npm run typecheck && npm run lint && npm test && npm run test:build",
    "test:db:namespace": "npx --yes supabase@2.121.0 db query --local --yes --file supabase/tests/cl_namespace_contract.sql",
    "db:install:colorlog": "node scripts/colorlog-db.cjs --install",
    "db:verify:colorlog": "node scripts/colorlog-db.cjs"
  },
  "private": true
}
