# Supabase project URL. This is safe to bundle but must be supplied per environment.
EXPO_PUBLIC_SUPABASE_URL=
# Supabase publishable/anon key. Never put a service-role key in this file or app.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# URL scheme used for deep links.
EXPO_PUBLIC_APP_SCHEME=mycolorlog
# EAS project ID used only to issue an Expo Push Token for friend-room photo notifications.
# Leave blank until an EAS project is created; never put a server secret here.
EXPO_PUBLIC_EAS_PROJECT_ID=
