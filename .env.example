# Supabase project URL. This is safe to bundle but must be supplied per environment.
EXPO_PUBLIC_SUPABASE_URL=
# Supabase publishable/anon key. Never put a service-role key in this file or app.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional fallback for tools without Expo config; native builds use app.config.ts.
# APP_VARIANT selects mycolorlog-dev, mycolorlog-preview, or mycolorlog.
EXPO_PUBLIC_APP_SCHEME=mycolorlog
# Optional fallback only: native builds use the linked EAS project in app.json.
# This is public metadata, not a server secret.
EXPO_PUBLIC_EAS_PROJECT_ID=
